# Gateway Bixs (WhatsApp + PIX) — mesmo padrão do PagWeb/Bixs
# POST /v1/api/payment/invoices para gerar PIX (pix_emv)
VITE_BIXS_API_BASE=https://api.bixs.com.br
VITE_BIXS_API_EMAIL=seu-email@exemplo.com
VITE_BIXS_API_PASSWORD=sua-senha

# Em dev, mensagens WhatsApp são redirecionadas para este número
VITE_BIXS_TEST_PHONE=31999999999