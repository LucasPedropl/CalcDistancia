# Gateway Bixs (WhatsApp + PIX) — mesmo padrão do PagWeb/Bixs
# Copie este arquivo para .env.local e preencha (não commite credenciais reais).
# POST /v1/api/payment/invoices para gerar PIX (pix_emv)
VITE_BIXS_API_BASE=https://api.bixs.com.br
VITE_BIXS_API_EMAIL=seu-email@exemplo.com
VITE_BIXS_API_PASSWORD=sua-senha

# Opcional: em dev, redireciona TODAS as mensagens WhatsApp para um número de teste.
# Deixe comentado para enviar ao número informado no pedido.
# VITE_BIXS_REDIRECT_TO_TEST_PHONE=true
# VITE_BIXS_TEST_PHONE=31999999999

# URL pública do app (links de rastreamento enviados no WhatsApp)
VITE_PUBLIC_APP_URL=http://localhost:5173

# Google Maps (camada detalhada + geocoding preciso) — habilite Maps JavaScript API,
# Geocoding API e Places API no Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=
